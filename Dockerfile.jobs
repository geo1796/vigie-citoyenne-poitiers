# ---------- Stage 1 : build du binaire ----------
FROM golang:1.26-alpine AS build

WORKDIR /src

COPY backend/go.mod backend/go.sum ./
RUN go mod download

COPY backend/ ./

RUN CGO_ENABLED=0 GOOS=linux go build \
    -trimpath \
    -ldflags="-s -w" \
    -o /out/vigie \
    ./server


# ---------- Stage 2 : runtime ----------
FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata && \
    addgroup -S vigie && \
    adduser -S -G vigie vigie

COPY --from=build /out/vigie /usr/local/bin/vigie

USER vigie:vigie

ENTRYPOINT ["/usr/local/bin/vigie"]
# Le serverless job override avec ["migrate", "up"] ou ["ingest", "..."]
CMD ["ingest"]